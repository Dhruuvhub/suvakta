// Suvakta Prisma schema
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Registered account used for login / leaderboard access
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String?
  avatarUrl    String?
  role         String   @default("member") // "member" | "admin"
  department   String?
  year         String?
  collegeEmail String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  delegations Delegation[]
}

/// MUN delegation record — submitted by members, reviewed by admins
model Delegation {
  id             String   @id @default(cuid())
  munName        String   // e.g. "Harvard MUN 2026"
  hostCollege    String   // e.g. "St. Stephen's College"
  delegationType String   // e.g. "Individual", "Team"
  awardsWon      String   @default("None")
  certificateUrl String?
  status         String   @default("pending") // "pending" | "approved" | "rejected"
  points         Int      @default(0)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

/// Team member for the public team page
model TeamMember {
  id           String  @id @default(cuid())
  fullName     String
  roleTitle    String  // e.g. "President", "USG Delegate Affairs"
  tier         String  // "core" | "secretariat"
  message      String? // short bio or message
  email        String?
  photoUrl     String?
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([displayOrder])
}
